---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { ABOUT } from "@consts";
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-2">
        <h1 class="text-2xl font-semibold text-zinc-950 dark:text-white">
          About
        </h1>
        <p>
          Focused on AI agent engineering across both application and platform
          layers.
        </p>
      </div>
      <article class="animate">
        <p>
          The work spans domain agent development, prompt and tool design,
          workflow orchestration, runtime architecture, event contracts, retrieval
          infrastructure, evaluation loops, tracing, and delivery pipelines.
        </p>
        <p>
          The goal is to make agents useful in real engineering environments:
          clear task boundaries, reliable tool use, observable execution,
          testable quality, reusable SDKs, and deployment paths that can survive
          production constraints.
        </p>
        <p>
          Public work is available on
          <Link href="https://github.com/RyzeAngler" external>GitHub</Link>.
        </p>
      </article>
    </div>
  </Container>
</PageLayout>
