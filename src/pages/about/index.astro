---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { ABOUT } from "@consts";
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <div class="max-w-3xl space-y-10">
      <div class="animate space-y-2">
        <h1 class="text-2xl font-semibold text-zinc-950 dark:text-white">
          About
        </h1>
        <p>
          I build AI agent systems across the application and platform layers.
        </p>
      </div>
      <article class="animate">
        <p>
          I work on domain agents, prompt and tool design, workflow orchestration,
          runtime architecture, event contracts, retrieval infrastructure, evaluation
          loops, tracing, and delivery pipelines.
        </p>
        <p>
          I want agents to be useful in real engineering environments. That means
          clear task boundaries, reliable tool use, observable execution, testable
          quality, reusable SDKs, and deployment paths that can survive production
          constraints.
        </p>
        <p>
          I publish public work on
          <Link href="https://github.com/RyzeAngler" external>GitHub</Link>.
        </p>
      </article>
    </div>
  </Container>
</PageLayout>
