---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { WRITING } from "@consts";

const topics = [
  "Building domain agents that survive real task boundaries",
  "Workflow orchestration with LangGraph, routing, clarification, and handoff",
  "Agent SDK design for memory, tools, streaming, and service exposure",
  "Event contracts between agent platforms and external systems",
  "RAG, KMS, and runtime file context for agent workflows",
  "Trace-based evaluation, LLM-as-a-Judge, and quality loops",
  "Langflow custom components for low-code agent workflows",
  "Evidence-based engineering profiles from Codex session history",
];
---

<PageLayout title={WRITING.TITLE} description={WRITING.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-2">
        <h1 class="text-2xl font-semibold text-zinc-950 dark:text-white">
          Writing
        </h1>
        <p>
          This page stays intentionally sparse until finished notes are ready to
          publish. The topics below reflect recurring engineering problems rather
          than a list of draft articles.
        </p>
      </div>
      <ul class="animate grid gap-3">
        {topics.map((topic) => (
          <li class="rounded-lg border border-zinc-200 p-4 dark:border-zinc-800">
            {topic}
          </li>
        ))}
      </ul>
    </div>
  </Container>
</PageLayout>
