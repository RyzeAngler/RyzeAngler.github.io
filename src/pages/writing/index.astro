---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { WRITING } from "@consts";

const topics = [
  "Building production-grade AI agents with LangGraph",
  "Separating user-agent messages from agent-LLM messages",
  "Designing runtime file context for agent workflows",
  "LLM-as-a-Judge beyond final-answer scoring",
  "Code RAG with AST, BM25, and embeddings",
  "Harness Engineering for agent-first development",
];
---

<PageLayout title={WRITING.TITLE} description={WRITING.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-2">
        <h1 class="text-2xl font-semibold text-zinc-950 dark:text-white">
          Writing
        </h1>
        <p>
          I keep this page intentionally sparse until there are finished notes to
          publish. These are the technical topics I expect to write about.
        </p>
      </div>
      <ul class="animate grid gap-3">
        {topics.map((topic) => (
          <li class="rounded-lg border border-zinc-200 p-4 dark:border-zinc-800">
            {topic}
          </li>
        ))}
      </ul>
    </div>
  </Container>
</PageLayout>
